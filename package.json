{
  "name": "maplet",
  "version": "0.3.0",
  "private": true,
  "description": "Maplet — a local, standalone 2D/3D viewer for plotting data points onto spatial coordinate maps from a CSV/TSV table (spatial cells, cities on a map, stars in space, …).",
  "scripts": {
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "vite build --mode singlefile && node scripts/finalize-standalone.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.171.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
